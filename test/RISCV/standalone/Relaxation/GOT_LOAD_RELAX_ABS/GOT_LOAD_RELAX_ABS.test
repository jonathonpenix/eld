REQUIRES: riscv32 || riscv64

# Relax GOT loads of absolute symbols. Depending on the symbol value:
#   - fits in 6-bit signed: the auipc is deleted and the lw/ld is compressed
#     to c.li (6 bytes total saved).
#   - fits in 12-bit signed but not 6-bit: the auipc is deleted and the lw/ld
#     is rewritten to addi rd, zero, <value> (4 bytes saved).
#
# A weak undefined symbol in a shared object must NOT be GOT-relaxed: the
# dynamic linker may provide a non-zero value at load time, so the GOT access
# must be preserved.

RUN: %clang %clangopts -c %p/Inputs/1.s -o %t.o

## Absolute symbol relaxation (static executable)
RUN: %link %linkopts --defsym sym=5 --defsym sym_neg=-31 --defsym sym_addi=32 --defsym sym_addi_neg=-33 --defsym sym_zero=0 --verbose -MapStyle txt -Map %t.map \
RUN:   %t.o -o %t.out 2>&1 | %filecheck %s --check-prefix=ABS-VERBOSE

ABS-VERBOSE:      RISCV_GOT : Deleting 4 bytes for symbol 'sym'
ABS-VERBOSE-NEXT: RISCV_LI_C : Deleting 2 bytes for symbol 'sym'
ABS-VERBOSE-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym
ABS-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_neg'
ABS-VERBOSE-NEXT: RISCV_LI_C : Deleting 2 bytes for symbol 'sym_neg'
ABS-VERBOSE-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_neg
ABS-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi'
ABS-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi'
ABS-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi_neg'
ABS-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi_neg'
ABS-VERBOSE-NEXT: RISCV_GOT : Cannot relax 4 bytes for symbol 'sym_zero'
ABS-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_wu'
ABS-VERBOSE-NEXT: RISCV_LI_C : Deleting 2 bytes for symbol 'sym_wu'
ABS-VERBOSE-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_wu

RUN: %objdump --no-print-imm-hex -M no-aliases -dr %t.out | %filecheck %s --check-prefix=ABS-DUMP

ABS-DUMP: c.li {{a[0-9]+}}, 5
ABS-DUMP: c.li {{a[0-9]+}}, -31
ABS-DUMP: addi {{a[0-9]+}}, zero, 32
ABS-DUMP: addi {{a[0-9]+}}, zero, -33
ABS-DUMP: auipc {{a[0-9]+}},
ABS-DUMP-NEXT: R_RISCV_GOT_HI20 sym_zero
ABS-DUMP: {{l[wd]}} {{a[0-9]+}},
ABS-DUMP-NEXT: R_RISCV_PCREL_LO12_I sym_zero
ABS-DUMP: c.li {{a[0-9]+}}, 0

RUN: %filecheck %s --input-file=%t.map --check-prefix=MAP
MAP: # RelaxationBytesDeleted : 26
MAP: # RelaxationBytesMissed : 8

## Weak undefined and absolute symbols in a shared object — must not be relaxed.
## isSymbolPreemptible returns true for all globally-visible symbols in a DSO,
## so GOT relaxation is suppressed regardless of whether the symbol is absolute
## or weak undefined.
RUN: %link %linkopts -shared \
RUN:   --defsym sym=5 --defsym sym_neg=-31 --defsym sym_addi=32 --defsym sym_addi_neg=-33 --defsym sym_zero=0 \
RUN:   --verbose %t.o -o %t.so 2>&1 | %filecheck %s --check-prefix=DSO-VERBOSE

DSO-VERBOSE-NOT: RISCV_GOT : Deleting
DSO-VERBOSE-NOT: RISCV_LI_C :

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.so | %filecheck %s --check-prefix=DSO-DUMP

DSO-DUMP:      <_start>:
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP:      <foo>:
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NOT:  c.li
DSO-DUMP-NOT:  addi {{a[0-9]+}}, zero,

## Absolute symbol relaxation with --no-relax-c (static executable)
## All symbols that would use c.li fall back to addi instead.
RUN: %link %linkopts --defsym sym=5 --defsym sym_neg=-31 --defsym sym_addi=32 --defsym sym_addi_neg=-33 --defsym sym_zero=0 \
RUN:   --no-relax-c --verbose -MapStyle txt -Map %t.norelaxc.map \
RUN:   %t.o -o %t.norelaxc.out 2>&1 | %filecheck %s --check-prefix=NRC-VERBOSE

NRC-VERBOSE:      RISCV_GOT : Deleting 4 bytes for symbol 'sym'
NRC-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym'
NRC-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_neg'
NRC-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_neg'
NRC-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi'
NRC-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi'
NRC-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi_neg'
NRC-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi_neg'
NRC-VERBOSE-NEXT: RISCV_GOT : Cannot relax 4 bytes for symbol 'sym_zero'
NRC-VERBOSE-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_wu'
NRC-VERBOSE-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_wu'

RUN: %objdump --no-print-imm-hex -M no-aliases -dr %t.norelaxc.out | %filecheck %s --check-prefix=NRC-DUMP

NRC-DUMP: addi {{a[0-9]+}}, zero, 5
NRC-DUMP: addi {{a[0-9]+}}, zero, -31
NRC-DUMP: addi {{a[0-9]+}}, zero, 32
NRC-DUMP: addi {{a[0-9]+}}, zero, -33
NRC-DUMP: auipc {{a[0-9]+}},
NRC-DUMP-NEXT: R_RISCV_GOT_HI20 sym_zero
NRC-DUMP: {{l[wd]}} {{a[0-9]+}},
NRC-DUMP-NEXT: R_RISCV_PCREL_LO12_I sym_zero
NRC-DUMP: addi {{a[0-9]+}}, zero, 0
NRC-DUMP-NOT: c.li

RUN: %filecheck %s --input-file=%t.norelaxc.map --check-prefix=NRC-MAP
NRC-MAP: # RelaxationBytesDeleted : 20
NRC-MAP: # RelaxationBytesMissed : 14
