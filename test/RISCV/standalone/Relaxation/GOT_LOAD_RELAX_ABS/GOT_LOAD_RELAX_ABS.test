REQUIRES: riscv32 || riscv64

# Relax GOT loads of absolute symbols. Depending on the symbol value:
#   - fits in 6-bit signed: the auipc is deleted and the lw/ld is compressed
#     to c.li (6 bytes total saved).
#   - fits in 12-bit signed but not 6-bit: the auipc is deleted and the lw/ld
#     is rewritten to addi rd, zero, <value> (4 bytes saved).
#
# A weak undefined symbol in a shared object must NOT be GOT-relaxed: the
# dynamic linker may provide a non-zero value at load time, so the GOT access
# must be preserved.

RUN: %clang %clangopts -c %p/Inputs/1.s -o %t.o

## Static executable
RUN: %link %linkopts -T %p/Inputs/syms.t --verbose -MapStyle txt -Map %t.static.map \
RUN: %t.o -o %t.static.out 2>&1 | %filecheck %s --check-prefixes=VERBOSE-COMMON,VERBOSE-C

## Static executable with --no-relax-c
RUN: %link %linkopts -T %p/Inputs/syms.t --no-relax-c --verbose -MapStyle txt -Map %t.norelaxc.map \
RUN: %t.o -o %t.norelaxc.out 2>&1 | %filecheck %s --check-prefixes=VERBOSE-COMMON,VERBOSE-NO-C

VERBOSE-COMMON: RISCV_GOT : Deleting 4 bytes for symbol 'sym_cli_pos'
VERBOSE-C-NEXT: RISCV_LI_C : Deleting 2 bytes for symbol 'sym_cli_pos'
VERBOSE-C-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_cli_pos
VERBOSE-NO-C-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_cli_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_cli_neg'
VERBOSE-C-NEXT: RISCV_LI_C : Deleting 2 bytes for symbol 'sym_cli_neg'
VERBOSE-C-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_cli_neg
VERBOSE-NO-C-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_cli_neg'
VERBOSE-COMMON-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_cli_pos_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_cli_pos_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_cli_neg_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_cli_neg_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 4 bytes for symbol 'sym_zero'
VERBOSE-COMMON-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_wu'
VERBOSE-C-NEXT: RISCV_LI_C : Deleting 2 bytes for symbol 'sym_wu'
VERBOSE-C-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_wu
VERBOSE-NO-C-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_wu'
VERBOSE-COMMON-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi_neg'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi_neg'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 4 bytes for symbol 'sym_addi_pos_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT : Cannot relax 4 bytes for symbol 'sym_addi_neg_oob'

RUN: %objdump --no-print-imm-hex -M no-aliases -dr %t.static.out | %filecheck %s --check-prefixes=DUMP-COMMON,DUMP-C
RUN: %objdump --no-print-imm-hex -M no-aliases -dr %t.norelaxc.out | %filecheck %s --check-prefixes=DUMP-COMMON,DUMP-NO-C

DUMP-C: c.li {{a[0-9]+}}, 31
DUMP-NO-C: addi {{a[0-9]+}}, zero, 31
DUMP-C: c.li {{a[0-9]+}}, -32
DUMP-NO-C: addi {{a[0-9]+}}, zero, -32
DUMP-COMMON: addi {{a[0-9]+}}, zero, 32
DUMP-COMMON: addi {{a[0-9]+}}, zero, -33
DUMP-COMMON: auipc {{a[0-9]+}},
DUMP-COMMON-NEXT: R_RISCV_GOT_HI20 sym_zero
DUMP-COMMON: {{l[wd]}} {{a[0-9]+}},
DUMP-COMMON-NEXT: R_RISCV_PCREL_LO12_I sym_zero
DUMP-C: c.li {{a[0-9]+}}, 0
DUMP-NO-C: addi {{a[0-9]+}}, zero, 0
DUMP-NO-C-NOT: c.li

DUMP-COMMON: <bar>:
DUMP-COMMON: addi {{a[0-9]+}}, zero, 2047
DUMP-COMMON: addi {{a[0-9]+}}, zero, -2048
DUMP-COMMON: auipc {{a[0-9]+}},
DUMP-COMMON-NEXT: R_RISCV_GOT_HI20 sym_addi_pos_oob
DUMP-COMMON: auipc {{a[0-9]+}},
DUMP-COMMON-NEXT: R_RISCV_GOT_HI20 sym_addi_neg_oob

RUN: %filecheck %s --input-file=%t.static.map --check-prefix=MAP-C
MAP-C: # RelaxationBytesDeleted : 34
MAP-C: # RelaxationBytesMissed : 20

RUN: %filecheck %s --input-file=%t.norelaxc.map --check-prefix=MAP-NO-C
MAP-NO-C: # RelaxationBytesDeleted : 28
MAP-NO-C: # RelaxationBytesMissed : 26

## Weak undefined and absolute symbols in a shared object — must not be relaxed.
## isSymbolPreemptible returns true for all globally-visible symbols in a DSO,
## so GOT relaxation is suppressed regardless of whether the symbol is absolute
## or weak undefined.
RUN: %link %linkopts -shared -T %p/Inputs/syms.t \
RUN: --verbose %t.o -o %t.so 2>&1 | %filecheck %s --check-prefix=DSO-VERBOSE

DSO-VERBOSE-NOT: RISCV_GOT : Deleting
DSO-VERBOSE-NOT: RISCV_LI_C :

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.so | %filecheck %s --check-prefix=DSO-DUMP

DSO-DUMP: <_start>:
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP: <foo>:
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP: <bar>:
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NOT: c.li
DSO-DUMP-NOT: addi {{a[0-9]+}}, zero,
