REQUIRES: riscv32 || riscv64

# Relax GOT loads of absolute symbols. Depending on the symbol value:
#   - fits in 6-bit signed: the auipc is deleted and the lw/ld is compressed
#     to c.li (6 bytes total saved).
#   - fits in 12-bit signed but not 6-bit: the auipc is deleted and the lw/ld
#     is rewritten to addi rd, zero, <value> (4 bytes saved).
#
# A weak undefined symbol in a shared object must NOT be GOT-relaxed: the
# dynamic linker may provide a non-zero value at load time, so the GOT access
# must be preserved.

RUN: %clang %clangopts -c %p/Inputs/1.s -o %t.o

## Absolute symbol relaxation (static executable)
RUN: %link %linkopts --defsym sym=5 --defsym sym_neg=-31 --defsym sym_addi=32 --verbose -MapStyle txt -Map %t.map \
RUN:   %t.o -o %t.out 2>&1 | %filecheck %s --check-prefix=ABS-VERBOSE

ABS-VERBOSE: RISCV_GOT : Deleting 4 bytes for symbol 'sym'
ABS-VERBOSE: RISCV_LI_C : Deleting 2 bytes for symbol 'sym'
ABS-VERBOSE: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym
ABS-VERBOSE: RISCV_GOT : Deleting 4 bytes for symbol 'sym_neg'
ABS-VERBOSE: RISCV_LI_C : Deleting 2 bytes for symbol 'sym_neg'
ABS-VERBOSE: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_neg
ABS-VERBOSE: RISCV_GOT : Deleting 4 bytes for symbol 'sym_addi'
ABS-VERBOSE: RISCV_GOT : Cannot relax 2 bytes for symbol 'sym_addi'

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.out | %filecheck %s --check-prefix=ABS-DUMP

ABS-DUMP: c.li {{a[0-9]+}}, 5
ABS-DUMP: c.li {{a[0-9]+}}, -31
ABS-DUMP: addi {{a[0-9]+}}, zero, 32
ABS-DUMP-NOT: auipc

RUN: %filecheck %s --input-file=%t.map --check-prefix=MAP
MAP: # RelaxationBytesDeleted : 22

## Weak undefined symbol in a shared object — must not be relaxed
RUN: %link %linkopts -shared --verbose %t.o -o %t.so 2>&1 | %filecheck %s --check-prefix=DSO-VERBOSE

DSO-VERBOSE-NOT: RISCV_GOT : Deleting {{.*}} bytes for symbol 'sym_wu'
DSO-VERBOSE-NOT: RISCV_LI_C : {{.*}} symbol sym_wu

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.so | %filecheck %s --check-prefix=DSO-DUMP

DSO-DUMP:      <foo>:
DSO-DUMP-NEXT: auipc {{a[0-9]+}},
DSO-DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DSO-DUMP-NOT:  c.li
