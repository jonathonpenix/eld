REQUIRES: riscv32 || riscv64

# A weak undefined symbol in a shared object must NOT be GOT-relaxed: the
# dynamic linker may provide a non-zero value at load time, so the GOT access
# must be preserved.

RUN: %clang %clangopts -c %p/Inputs/weak_undef.s -o %t.o
RUN: %link %linkopts -shared --verbose %t.o -o %t.so 2>&1 | %filecheck %s --check-prefix=VERBOSE

VERBOSE-NOT: RISCV_GOT : Deleting {{.*}} bytes for symbol 'sym_wu'
VERBOSE-NOT: RISCV_LI_C : {{.*}} symbol sym_wu

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.so | %filecheck %s --check-prefix=DUMP

DUMP: auipc {{a[0-9]+}},
DUMP-NEXT: {{l[wd]}} {{a[0-9]+}},
DUMP-NOT: c.li
