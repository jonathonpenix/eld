REQUIRES: riscv64
#----------GOT_LOAD_RELAX_REL_RV64.test----------------- Executable------------------#
#BEGIN_COMMENT
# This tests checks GOT load relaxation behavior specific to handling relative symbols
# for rv64 targets.
#END_COMMENT
#START_TEST

## Test that the relaxation is not performed for symbols == 0 for rv64 and
## bounds are correctly checked
RUN: %clang %clangopts -c %p/Inputs/rel_rv64.s -o %t.o
RUN: %link %linkopts -static --verbose -T %p/Inputs/rel_rv64.t %t.o -o %t.static.out 2>&1 | %filecheck %s --check-prefix=VERBOSE

VERBOSE: RISCV_GOT_LOAD : Cannot relax 0 bytes for symbol 'var'
VERBOSE-NEXT: RISCV_GOT_LOAD : Cannot relax 0 bytes for symbol 'var3'

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.static.out | %filecheck %s --check-prefix=DUMP

DUMP: auipc a0,
DUMP: {{l[wd]}} a0,
DUMP: auipc a1,
DUMP: addi a1, {{a[0-9]+}},
DUMP: auipc a2,
DUMP: {{l[wd]}} a2,
