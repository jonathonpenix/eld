REQUIRES: riscv32 || riscv64

# Relax GOT loads of absolute symbols. Depending on the symbol value:
#   - fits in 6-bit signed: the auipc is deleted and the lw/ld is compressed
#     to c.li (6 bytes total saved).
#   - fits in 12-bit signed but not 6-bit: the auipc is deleted and the lw/ld
#     is rewritten to addi rd, zero, <value> (4 bytes saved).

RUN: %clang %clangopts -c %p/Inputs/abs.s -o %t.o

## Static executable
RUN: %link %linkopts -static -T %p/Inputs/abs_syms.t --verbose -MapStyle txt -Map %t.static.map \
RUN: %t.o -o %t.static.out 2>&1 | %filecheck %s --check-prefixes=VERBOSE-COMMON,VERBOSE-C

## Static, pie executable
RUN: %link %linkopts -T %p/Inputs/abs_syms.t -static -pie --verbose -MapStyle txt -Map %t.static-pie.map \
RUN: %t.o -o %t.static-pie.out 2>&1 | %filecheck %s --check-prefixes=VERBOSE-COMMON,VERBOSE-C

## Static executable with --no-relax-c
RUN: %link %linkopts -T %p/Inputs/abs_syms.t -static --no-relax-c --verbose -MapStyle txt -Map %t.norelaxc.map \
RUN: %t.o -o %t.norelaxc.out 2>&1 | %filecheck %s --check-prefixes=VERBOSE-COMMON,VERBOSE-NO-C

VERBOSE-COMMON: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_cli_pos'
VERBOSE-C-NEXT: RISCV_GOT_LOAD : Deleting 2 bytes for symbol 'sym_cli_pos'
VERBOSE-C-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_cli_pos
VERBOSE-NO-C-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_cli_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_cli_neg'
VERBOSE-C-NEXT: RISCV_GOT_LOAD : Deleting 2 bytes for symbol 'sym_cli_neg'
VERBOSE-C-NEXT: RISCV_LI_C : relaxing instruction {{.*}} to compressed instruction {{.*}} for symbol sym_cli_neg
VERBOSE-NO-C-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_cli_neg'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_cli_pos_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_cli_pos_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_cli_neg_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_cli_neg_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_addi_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_addi_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_addi_neg'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_addi_neg'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 4 bytes for symbol 'sym_addi_pos_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 4 bytes for symbol 'sym_addi_neg_oob'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 4 bytes for symbol 'sym_zero'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_cli_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_cli_pos'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_hidden'
VERBOSE-COMMON-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_hidden'

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.static.out | %filecheck %s --check-prefixes=DUMP-COMMON,DUMP-C
RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.static-pie.out | %filecheck %s --check-prefixes=DUMP-COMMON,DUMP-C
RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.norelaxc.out | %filecheck %s --check-prefixes=DUMP-COMMON,DUMP-NO-C

DUMP-C: c.li a0, 31
DUMP-NO-C: addi a0, zero, 31
DUMP-C: c.li a1, -32
DUMP-NO-C: addi a1, zero, -32
DUMP-COMMON: addi a2, zero, 32
DUMP-COMMON: addi a3, zero, -33
DUMP-COMMON: addi a0, zero, 2047
DUMP-COMMON: addi a1, zero, -2048
DUMP-COMMON: auipc a2,
DUMP-COMMON-NEXT: {{l[wd]}} a2,
DUMP-COMMON: auipc a3,
DUMP-COMMON-NEXT: {{l[wd]}} a3,
DUMP-COMMON: auipc a0,
DUMP-COMMON-NEXT: {{l[wd]}} a0,
DUMP-COMMON: addi zero, zero, 31
DUMP-COMMON: addi a1, zero, 42
DUMP-NO-C-NOT: c.li

RUN: %filecheck %s --input-file=%t.static.map --check-prefix=MAP-C
RUN: %filecheck %s --input-file=%t.static-pie.map --check-prefix=MAP-C
MAP-C: # RelaxationBytesDeleted : 36
MAP-C: # RelaxationBytesMissed : 24

RUN: %filecheck %s --input-file=%t.norelaxc.map --check-prefix=MAP-NO-C
MAP-NO-C: # RelaxationBytesDeleted : 32
MAP-NO-C: # RelaxationBytesMissed : 28

## Shared. The psABI only includes "it’s bound at link time to be within the
## object" as a condition for the relative case, but it is enforced in eld for
## the absolute case as well. Check that no relaxation is performed for
## preemptible absolute symbols.
RUN: %link %linkopts -shared -T %p/Inputs/abs_syms.t \
RUN: --verbose -MapStyle txt -Map %t.dso.map %t.o -o %t.so 2>&1 | %filecheck %s --check-prefix=DSO-VERBOSE

DSO-VERBOSE: RISCV_GOT_LOAD : Deleting 4 bytes for symbol 'sym_hidden'
DSO-VERBOSE-NEXT: RISCV_GOT_LOAD : Cannot relax 2 bytes for symbol 'sym_hidden'

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.so | %filecheck %s --check-prefix=DSO-DUMP

DSO-DUMP: auipc a0,
DSO-DUMP-NEXT: {{l[wd]}} a0,
DSO-DUMP-NEXT: auipc a1,
DSO-DUMP-NEXT: {{l[wd]}} a1,
DSO-DUMP-NEXT: auipc a2,
DSO-DUMP-NEXT: {{l[wd]}} a2,
DSO-DUMP-NEXT: auipc a3,
DSO-DUMP-NEXT: {{l[wd]}} a3,
DSO-DUMP-NEXT: auipc a0,
DSO-DUMP-NEXT: {{l[wd]}} a0,
DSO-DUMP-NEXT: auipc a1,
DSO-DUMP-NEXT: {{l[wd]}} a1,
DSO-DUMP-NEXT: auipc a2,
DSO-DUMP-NEXT: {{l[wd]}} a2,
DSO-DUMP-NEXT: auipc a3,
DSO-DUMP-NEXT: {{l[wd]}} a3,
DSO-DUMP-NEXT: auipc a0,
DSO-DUMP-NEXT: {{l[wd]}} a0,
DSO-DUMP-NEXT: auipc zero,
DSO-DUMP-NEXT: {{l[wd]}} zero,
DSO-DUMP-NEXT: addi a1, zero, 42
DSO-DUMP-NOT: c.li
DSO-DUMP-NOT: addi {{a[0-9]+}}, zero,

RUN: %filecheck %s --input-file=%t.dso.map --check-prefix=MAP-DSO
MAP-DSO: # RelaxationBytesDeleted : 4
MAP-DSO: # RelaxationBytesMissed : 2
