REQUIRES: riscv32 || riscv64

# Relax GOT loads of relative symbols. The symbol is non-preemptible in a
# static executable, so the GOT indirection can be replaced with a direct
# PC-relative address materialisation:
#
#   auipc tX, %got_pcrel_hi(sym)   ->   auipc tX, %pcrel_hi(sym)
#   lw/ld tY, %pcrel_lo(label)(tX) ->   addi  tY, tX, %pcrel_lo(label)

RUN: %clang %clangopts -c %p/Inputs/rel.s -o %t.o

## Static executable
RUN: %link %linkopts -static %t.o -o %t.static.out

## Static, pie executable
RUN: %link %linkopts -static -pie %t.o -o %t.static-pie.out 2>&1

RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.static.out | %filecheck %s --check-prefix=DUMP
RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.static-pie.out | %filecheck %s --check-prefix=DUMP

DUMP: auipc a0,
DUMP-NEXT: addi a0, a0,
DUMP: auipc a1,
DUMP-NEXT: addi a1, a1,
DUMP: auipc a2,
DUMP-NEXT: {{l[wd]}} a2,

## Shared
RUN: %link %linkopts -shared %t.o -o %t.so
RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.so | %filecheck %s --check-prefix=SHARED-DUMP

SHARED-DUMP: auipc a0,
SHARED-DUMP-NEXT: {{l[wd]}} a0,
SHARED-DUMP-NEXT: auipc a1,
SHARED-DUMP-NEXT: addi a1, a1,
SHARED-DUMP-NEXT: auipc a2,
SHARED-DUMP-NEXT: {{l[wd]}} a2,

## Check nonsequential relaxations look as expected.
RUN: %clang %clangopts -DUSE_REL=1 -c %p/Inputs/nonsequential.S -o %t.nonseq.o
RUN: %link %linkopts -static %t.nonseq.o -o %t.nonseq.out
RUN: %objdump --no-print-imm-hex -M no-aliases -d %t.nonseq.out | %filecheck %s --check-prefixes=DUMP-NONSEQ

DUMP-NONSEQ-LABEL: <foo>:
DUMP-NONSEQ: auipc a0,
DUMP-NONSEQ: nop
DUMP-NONSEQ: nop
DUMP-NONSEQ: addi a3, a0,
DUMP-NONSEQ: auipc a1,
DUMP-NONSEQ: addi a1, a1,
DUMP-NONSEQ: addi a2, a0,

DUMP-NONSEQ-COMMON-LABEL: <bar>:
DUMP-NONSEQ-COMMON: lw a0,
DUMP-NONSEQ-COMMON: auipc a0,
